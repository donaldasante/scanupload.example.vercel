# Browser-side variables exposed through `NEXT_PUBLIC_*`.
# Copy this file to .env.local and replace the client ID with your own.

# Direct ScanUpload hub endpoint used to create a session.
NEXT_PUBLIC_SESSION_URL=https://hub.scanupload.net/api/v2/front-end/session

# Tenant client ID from https://app.scanupload.net/dashboard. This is public;
# never place a client secret in a NEXT_PUBLIC_* variable.
NEXT_PUBLIC_CLIENT_ID=your-tenant-id
